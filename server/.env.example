# 線上版伺服器的設定範例（D-305，25 §4.5）。複製成 server/.env 自己填；.env 不進 git。
# 開發：Windows LocalDB（先建資料庫 JackyGameDev；Node 要另外 npm install msnodesqlv8）
GAME_DB_CONNECTION_STRING=Server=(localdb)\MSSQLLocalDB;Database=JackyGameDev;Trusted_Connection=True;
# 之後換成 JackyAIStudio 的 Azure SQL（Jacky 自己填）
GAME_DB_SCHEMA=game
# 啟動時跑遷移（只建 game schema 裡自己的表，絕不碰 dbo 與舊原型表）；0＝不跑
GAME_DB_MIGRATE=1
# 目前只支援 dev（token「dev:<名字>」）；JWT 做好之前不要對外開
AUTH_MODE=dev
PORT=8080
# 允許的網頁來源（逗號分隔），例如 GitHub Pages
CORS_ORIGINS=https://twjackysu.github.io
