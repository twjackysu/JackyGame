  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "22.20.5",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
