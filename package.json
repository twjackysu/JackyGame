{
  "name": "jackygame",
  "private": true,
  "version": "1.1.0",
  "description": "命運之境：轉生後的異世界冒險 Realm of Fate - a mobile RPG built with Phaser 3",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "icons:native": "node scripts/gen-native-icons.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "playthrough": "node scripts/playthrough.mjs",
    "wiki": "WIKI=1 vitest run tests/wiki-gen.test.ts",
    "sim:rt": "RT_REPORT=1 vitest run tests/rt-report.test.ts",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
